# ---- Client env (rename to .env.local) ----

# Express API base URL (leave EMPTY in dev — Next proxies /api/* to the backend)
NEXT_PUBLIC_API_URL=

# ---- Better Auth (Google sign-in, server-side only) ----
# OAuth round trip runs in this Next app at /api/better-auth/*.
# Create a Web OAuth 2.0 client in Google Cloud Console:
#   Authorized JS origins:  http://localhost:3000
#   Authorized redirect URI: http://localhost:3000/api/better-auth/callback/google
MONGODB_URI=
MONGODB_DB=studiospace
# Public origin of this Next app — better-auth builds the Google redirect
# and its trusted-origins list from this. Use the deployed URL in production.
BETTER_AUTH_URL=http://localhost:3000
# Optional: comma-separated extra origins to trust (preview URLs, LAN IPs)
# BETTER_AUTH_TRUSTED_ORIGINS=https://my-preview.e2b.dev,http://192.168.1.5:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
